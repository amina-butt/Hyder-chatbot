# --- Environment & Security ---
ENVIRONMENT=development
API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# --- Google Gemini (google-genai SDK) ---
GEMINI_API_KEY=your_google_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=510
GEMINI_TIMEOUT_SECONDS=30.0

# --- Vector store (ChromaDB) ---
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=hyder_bikes_kb

# --- Embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- FAQ Router ---
FAQ_JSON_PATH=faqs.json

# --- Knowledge base ingestion ---
DATA_FILE_PATH=data/hyder_bikes.txt
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
TOP_K_RESULTS=4

# --- Conversation memory ---
MAX_HISTORY_TURNS=6

# --- Logging ---
LOG_DIR=logs
LOG_FILE_NAME=app.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# --- Audio Processing ---
MAX_AUDIO_FILE_SIZE_MB=10

# --- Company / support info ---
COMPANY_NAME=Hyder Electric Bikes
HUMAN_HANDOFF_CONTACT=0309 9432 432
HANDOFF_EMAIL=support@hyderbikes.pk

# --- Chatwoot (WhatsApp integration) ---
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=